# ===========================================
# 환경 변수 템플릿
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 키 값을 채워 넣으세요.
#   cp .env.example .env
# .env 는 git 에 커밋되지 않습니다 (.gitignore 처리됨).
# ===========================================

# NVIDIA API 키 (LangChain 실습 / LLM-as-a-Judge 에서 사용 — OpenAI SDK 호환 엔드포인트)
# 발급: https://build.nvidia.com  (키 형식: nvapi-...)
NVIDIA_KEY2=nvapi-...

# HuggingFace 액세스 토큰 (gated 모델 다운로드 / Hub 업로드 시 필요)
# 발급: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# (참고) 원본 과정은 OpenAI 를 썼습니다. 이 버전은 사용하지 않습니다.
# OPENAI_API_KEY=sk-...
